# Guardrails proxy configuration
SWITCH_TRUST_GATEWAY_URL=https://api.switchagents.ai
SWITCH_TRUST_API_KEY=grl_sk_your_api_key
SWITCH_TRUST_POLICY_ID=optional_policy_id

# AGENT_NAME or AGENT_ID names the agent for AUM and guardrails. wrap() and the plugins send it as X-Agent-Name / X-Agent-Id.
# AGENT_NAME=
# AGENT_ID=

# Provider API keys (set one for auto-detection in smoke-test.ts;
# sdk-framework-provider-matrix-test.ts can use several at once to run more combinations)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# Google ADK requires one of these (not GOOGLE_API_KEY):
# GOOGLE_GENAI_API_KEY=AIza...
# GEMINI_API_KEY=AIza...

# Optional model overrides for sdk-framework-provider-matrix-test.ts (defaults shown)
# SWITCH_TRUST_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# SWITCH_TRUST_OPENAI_MODEL=gpt-4o-mini
# SWITCH_TRUST_GOOGLE_MODEL=gemini-3.6-flash
